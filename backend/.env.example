PORT="8080"
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD=""
DATABASE_NAME="ola_db"
DATABASE_URL="mysql://root:@127.0.0.1:3306/ola_db"
ADMIN_USERNAME="your_admin_email"
ADMIN_PASSWORD="your_admin_password"
JWT_SECRET="generate_with: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
MIDTRANS_SERVER_KEY="Mid-server-xxx"
MIDTRANS_CLIENT_KEY="Mid-client-xxx"
MIDTRANS_IS_PRODUCTION="false"
CLOUDCONVERT_API_KEY="your_cloudconvert_api_key"
# CORS origins (dipisah koma) — include port vite dev user (5175) & admin (5176)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://localhost,http://127.0.0.1"
# SMTP — dipakai untuk OTP email & receipt pesanan
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Ola ATK <your_smtp_user>"